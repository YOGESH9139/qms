# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. Used by API route handlers. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Postgres connection for migrations + seeding (Project Settings -> Database -> Connection string) ---
# Use the "Session pooler" URI (IPv4-friendly), port 5432. URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# --- Anthropic (optional: every LLM call has a rule-based fallback) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
